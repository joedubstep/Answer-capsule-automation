    {
      "id": "british_ise",
      "label": "British -ise spelling",
      "skip_proper": true,
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client",
        "internal"
      ],
      "kind": "regex",
      "pattern": "\\b(?:organ|real|recogn|apolog|special|priorit|emphas|personal|optim|minim|maxim|custom|final|summar|util|author|critic|categor|standard|visual|memor|capital|central|character|digit|energ|familiar|formal|general|harmon|hospital|ideal|initial|legal|local|modern|normal|stabil|symbol|synchron|theor|equal|mobil|national|natural|popular|privat|rational|scrutin|sensit|social|vital|global|human|individual|industrial|item|jeopard|legitim|magnet|mechan|moral|monet|incentiv|public|random|regular|revital|sympath|systemat|strateg)is(?:e|ed|es|ing|er|ers|ation|ations|ational|ationally)\\b",
      "suggest": [
        "is(e|ed|es|ing|er|ers|ation|ations|ational|ationally)$",
        "iz$1"
      ],
      "message": "British -ise spelling. Surven writes US English only.",
      "fix_use": "Write '{use}' instead.",
      "fix": "Use the US spelling with a z."
    },
    {
      "id": "care_home",
      "label": "Care home",
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client"
      ],
      "kind": "regex",
      "pattern": "\\b(?:(?:memory|personal|residential|adult|group|foster|nursing|skilled|board\\s+and)\\s+)?care[\\s-]+homes?\\b",
      "skip_if": [
        {
          "pattern": "(?:memory|personal|residential|adult|group|foster|nursing|skilled|board\\s+and)\\s+care[\\s-]+homes?",
          "flags": "i"
        },
        {
          "pattern": "Care[\\s-]+Homes?",
          "flags": ""
        }
      ],
      "message": "'Care home' is British and never goes in client-facing text.",
      "fix": "Say assisted living, senior living, the community, or the home."
    },
    {
      "id": "care_home_name",
      "label": "Care Home in a name",
      "severity": "warn",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client"
      ],
      "kind": "regex",
      "flags": "",
      "pattern": "\\bCare[\\s-]+Homes?\\b",
      "message": "'Care Home' with capitals. Fine if it is part of a home's own name. Never in Surven's own words.",
      "fix": "If this is not the home's name, say assisted living, senior living, or the home."
    },
    {
      "id": "patients",
      "label": "Patients",
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client"
      ],
      "kind": "regex",
      "pattern": "\\bpatients\\b|\\bpatient's|\\b(?:a|the|each|every|new|one|your|our|their|per|no|any|more|future|current|prospective|potential)\\s+patient\\b",
      "message": "The people who live there are residents, not patients.",
      "fix": "Say residents."
    },
    {
      "id": "leads_for_families",
      "label": "Leads",
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client"
      ],
      "kind": "regex",
      "pattern": "\\b(?:(?:he|she|who|which|it)\\s+)?leads\\b(?![\\s-]+(?:to|into|the\\s+(?:team|staff|way|charge|front\\s+desk|tours?|admissions|intake|calls?|care|kitchen|activities)|admissions|intake|operations|nursing|activities|marketing|sales|tours|our\\s+team|by\\s+example)\\b)|\\b(?:(?:take|took|takes|taking)\\s+)?(?:new|every|each|one|more|fresh|hot|warm|cold|qualified|inbound|incoming|web|ad|form|family|good|quality|a|the|your|our|that|this)\\s+lead\\b(?![\\s-]+(?:to|into|the|a|an|by|with|on|in|time|times|generation|caregivers?|nurses?|aides?|cnas?|med|meds|medication|techs?|technicians?|cooks?|chefs?|housekeepers?|staff|administrators?|directors?|coordinators?|managers?|supervisors?|roles?|positions?)\\b)",
      "skip_if": [
        {
          "pattern": "(?:he|she|who|which|it)\\s+leads",
          "flags": "i"
        },
        {
          "pattern": "(?:take|took|takes|taking)\\s+the\\s+lead",
          "flags": "i"
        }
      ],
      "message": "Families are people, not leads. Owners hear 'leads' as numbers.",
      "fix": "Say families (or inquiries)."
    },
    {
      "id": "cold_outreach_words",
      "label": "Audit or score word",
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms"
      ],
      "kind": "regex",
      "pattern": "\\b(?:audit(?:s|ed|ing)?|assess(?:ed|es|ing|ment|ments)?|grade[sd]?|grading|scor(?:e|es|ed|ing))\\b",
      "message": "Never say audit, assessment, grade or score in cold outreach. It sounds like a test they can fail.",
      "fix": "Cut the word. Say what you looked at in plain words, like 'I looked at your website.'"
    },
    {
      "id": "bad_time_ask",
      "label": "Bad time ask",
      "severity": "block",
      "severity_by_context": {
        "client": "warn"
      },
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client"
      ],
      "kind": "regex",
      "pattern": "\\b(?:is|was|would)\\s+(?:now|this|it|today|tomorrow)\\s+(?:still\\s+)?(?:be\\s+)?(?:an?\\s+)?(?:bad|good|better|okay|ok|convenient|fine)\\s+time\\b|\\b(?:bad|good|better|convenient)\\s+time\\s+to\\s+(?:talk|chat|call|connect|speak|catch\\s+up|hop\\s+on)\\b|\\bcatch\\s+you\\s+at\\s+a\\s+bad\\s+time\\b|\\bwhen(?:'s|\\s+is|\\s+would\\s+be)\\s+(?:a\\s+)?(?:good|better|best|convenient)\\s+time\\b",
      "message": "Never ask 'is now a bad time' or 'when is a good time to talk'. It is the weakest ask there is.",
      "fix": "Ask one short question about their situation instead, 2 to 5 words."
    },
    {
      "id": "price_before_call",
      "label": "Price before the call",
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms"
      ],
      "kind": "regex",
      "pattern": "\\$\\s?\\d[\\d,]{0,15}(?:\\.\\d+)?(?:\\s?[km]\\b)?|\\b\\d[\\d,]{0,15}(?:\\.\\d+)?\\s?(?:k\\s+)?(?:dollars|bucks|usd)\\b|\\bper\\s+(?:month|mo|year|yr|week|wk)\\b|/\\s?(?:mo|mos|month|yr|year|wk|week)\\b|\\bmonthly\\s+(?:fee|price|cost|rate|retainer|payment|subscription)\\b|\\b(?:price|pricing|cost|fee|retainer)\\s+(?:is|starts\\s+at|of)\\s+\\$?\\d|\\b\\d[\\d,]{0,15}(?:\\.\\d+)?\\s?k?\\s+(?:a|an|each|every)\\s+(?:month|year|week)\\b|\\b(?:hundred|thousand|grand)\\s+(?:a|an|per|each|every)\\s+(?:month|mo|year|week)\\b",
      "message": "No price before the call. Not a number, not a range.",
      "fix": "Cut the price. Say you will go over cost on the call. If it is not a price, say it without 'per month'."
    },
