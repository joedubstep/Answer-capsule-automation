{
  "_about": "Surven Copy Checker rules. Single source of truth for tools/copy_check/check.py and the Copy Checker page. Edit here, run the tests, rebuild the page. kind: regex | wordlist | metric. Patterns must work in both Python re and JavaScript RegExp: no lookbehind, no inline flags, no $ or ^ anchors except where noted. Wordlist entries match whole words, case-insensitive; a space or hyphen in an entry matches either; a trailing * matches any word ending; 're:' starts a raw regex. skip_if: a match that fully matches one of these is ignored (use it instead of lookbehind). skip_proper: a Capitalized match in the middle of a sentence is treated as a name and ignored. severity_by_context overrides severity for one context. suppressed_by: drop this rule's issues when the named rule fired. before: the character just before a match must match this (or be the start of the text).",
  "version": "2026-11-02.2",
  "contexts": {
    "prospect_email": "Cold email",
    "prospect_sms": "Cold text",
    "client": "Client",
    "internal": "Internal"
  },
  "rules": [
    {
      "id": "dash",
      "label": "Dash",
      "severity": "block",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client",
        "internal"
      ],
      "kind": "regex",
      "pattern": "[\u2012\u2013\u2014\u2015\u2e3a\u2e3b\ufe31\ufe32\ufe58]|&(?:mdash|ndash|horbar);?|&#(?:8210|8211|8212|8213|x201[2-5]);?",
      "message": "Em and en dashes are banned. They read as AI-written.",
      "fix": "Use a period, a comma or a colon instead. Inside a name, use a plain hyphen."
    },
    {
      "id": "spaced_hyphen",
      "label": "Hyphen used as a dash",
      "severity": "warn",
      "contexts": [
        "prospect_email",
        "prospect_sms",
        "client",
        "internal"
      ],
      "kind": "regex",
      "pattern": "\\w[ \\t]+--?[ \\t]+(?=\\w)|\\w--(?=\\w)",
      "message": "A hyphen with spaces around it is a dash in disguise.",
      "fix": "Use a period or a comma. For a range, write 'to', like 9 to 5."
    },
